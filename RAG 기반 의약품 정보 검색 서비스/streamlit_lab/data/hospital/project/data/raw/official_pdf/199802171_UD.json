      "text": "                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n       용법용량                                                                       \n                                                                                  \n       성인                                                                         \n                                                                                  \n                                                                                  \n        \u0000:\u0000암브록솔염산염으로서\u0000치료초기에\u00001회\u000030\u0000mg\u00001일\u00003회\u0000복용하고\u0000계속\u0000치료\u0000시\u00001회\u000015\u0000mg\u00001일\u0000              \n        3회\u0000복용한다.                                                                  \n                                                                                  \n                                                                                  \n       소아                                                                         \n                                                                                  \n                                                                                  \n        5세\u0000이상\u0000:\u00001회\u000015\u0000mg\u00001일\u00002\u0000∼\u00003회\u0000복용한다.                                          \n                                                                                  \n                                                                                  \n        2\u0000∼\u00004세\u0000:\u00001회\u00007.5\u0000mg\u00001일\u00003회\u0000복용한다.                                            \n                                                                                  \n        이\u0000약은\u0000식사와\u0000관계없이\u0000복용할\u0000수\u0000있다.                                                   \n                                                                                  \n                                                                                  \n        만\u00002세\u0000미만에게\u0000투여하지\u0000않는다.\u0000다만,\u0000꼭\u0000필요한\u0000경우\u0000의사의\u0000진료를\u0000받는다.                             \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                                                                                  \n                   